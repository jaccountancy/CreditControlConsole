APP_ENV=production
PORT=8000
BASE_URL=https://jenius.jaccountancy.co.uk
DATABASE_URL=postgresql://USER:PASSWORD@HOST.railway.internal:5432/railway
APP_SECRET=replace-with-a-long-random-secret
WIDGET_TOKEN=replace-with-a-long-random-widget-token
XERO_CLIENT_ID=replace-me
XERO_CLIENT_SECRET=replace-me
XERO_REDIRECT_URI=https://jenius.jaccountancy.co.uk/auth/xero/callback
XERO_SCOPES=openid profile email offline_access accounting.invoices accounting.payments accounting.banktransactions accounting.manualjournals accounting.contacts accounting.settings accounting.attachments accounting.reports.banksummary.read accounting.reports.balancesheet.read accounting.reports.profitandloss.read accounting.reports.trialbalance.read payroll.employees payroll.payruns
XERO_ENABLE_PAYROLL_SCOPES=false
XERO_PRIMARY_TENANT_NAME=Jaccountancy UK Ltd
IGNITION_CLIENT_ID=replace-me
IGNITION_CLIENT_SECRET=replace-me
IGNITION_REDIRECT_URI=https://jenius.jaccountancy.co.uk/api/ignition/callback
# Legacy alias also supported if already present in Railway:
# IGNITION_REDIRECT_URL=https://jenius.jaccountancy.co.uk/api/ignition/callback
IGNITION_SCOPES=reporting
IGNITION_RENEWALS_RECIPIENT_EMAIL=amie@jaccountancy.co.uk
FOXIT_BASE_URL=https://na1.fusion.foxit.com
FOXIT_CLIENT_ID=replace-me
FOXIT_CLIENT_SECRET=replace-me
FOXIT_ENV=sandbox
FOXIT_ESIGN_SEND_PATH=/api/esign/v1/requests
FOXIT_ESIGN_RESEND_PATH=/api/esign/v1/requests/:requestId/resend
FOXIT_ESIGN_CANCEL_PATH=/api/esign/v1/requests/:requestId/cancel
FOXIT_ESIGN_STATUS_PATH=/api/esign/v1/requests/:requestId
PANEL_ALLOWED_ORIGINS=https://jenius.jaccountancy.co.uk,https://jaccountancy.co.uk,https://www.jaccountancy.co.uk
XERO_STATE_TTL_SECONDS=900
IGNITION_STATE_TTL_SECONDS=3600
DEVICE_CODE_TTL_MINUTES=10
SESSION_TTL_DAYS=30
STATUTORY_INTEREST_RATE=0.08
LATE_PAYMENT_CHARGE_ACCOUNT_CODE=1222
LATE_PAYMENT_CHARGE_TAX_TYPE=OUTPUT2
BAD_DEBT_WRITE_OFF_ACCOUNT_CODE=402
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
ME_REPORT_OPENAI_MODEL=gpt-5
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=bookkeeping@jaccountancy.co.uk
SMTP_FROM_NAME=Jaccountancy
SMTP_USE_TLS=true
ME_REPORT_BCC_EMAIL=fmfhdkgaptpyubgms@accountancymanager.co.uk
GMAIL_CLIENT_ID=replace-me
GMAIL_CLIENT_SECRET=replace-me
GMAIL_REDIRECT_URI=https://jenius.jaccountancy.co.uk/auth/gmail/callback
GMAIL_SCOPES=openid email https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/gmail.readonly
# Companies House defaults. Leave blank in production - configure via the Companies House settings page so values are encrypted in the database.
COMPANIES_HOUSE_ENVIRONMENT=sandbox
COMPANIES_HOUSE_API_KEY=
COMPANIES_HOUSE_PRESENTER_ID=
COMPANIES_HOUSE_PRESENTER_AUTH=
COMPANIES_HOUSE_CREDIT_ACCOUNT=
CH_ALERT_WEBHOOK_URL=
