APP_ENV=production
BASE_URL=https://creditcontrolconsole-production.up.railway.app
DATABASE_URL=postgresql://USER:PASSWORD@HOST.railway.internal:5432/railway
APP_SECRET=replace-with-a-long-random-secret
WIDGET_TOKEN=replace-with-a-long-random-widget-token
XERO_CLIENT_ID=replace-me
XERO_CLIENT_SECRET=replace-me
XERO_REDIRECT_URI=https://creditcontrolconsole-production.up.railway.app/auth/xero/callback
XERO_SCOPES=openid profile email offline_access accounting.invoices accounting.payments accounting.contacts accounting.settings.read accounting.attachments accounting.reports.read accounting.transactions.read accounting.journals.read assets
IGNITION_CLIENT_ID=replace-me
IGNITION_CLIENT_SECRET=replace-me
IGNITION_REDIRECT_URI=https://creditcontrolconsole-production.up.railway.app/api/ignition/callback
# Legacy alias also supported if already present in Railway:
# IGNITION_REDIRECT_URL=https://creditcontrolconsole-production.up.railway.app/api/ignition/callback
IGNITION_SCOPES=reporting
IGNITION_RENEWALS_RECIPIENT_EMAIL=amie@jaccountancy.co.uk
IGNITION_RENEWALS_ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/replace-me/replace-me/
PANEL_ALLOWED_ORIGINS=https://www.team.jaccountancy.co.uk,https://team.jaccountancy.co.uk,https://my.jaccountancy.co.uk
XERO_STATE_TTL_SECONDS=900
IGNITION_STATE_TTL_SECONDS=3600
DEVICE_CODE_TTL_MINUTES=10
SESSION_TTL_DAYS=30
STATUTORY_INTEREST_RATE=0.08
LATE_PAYMENT_CHARGE_ACCOUNT_CODE=1222
LATE_PAYMENT_CHARGE_TAX_TYPE=OUTPUT2
BAD_DEBT_WRITE_OFF_ACCOUNT_CODE=402
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-4.1-mini
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=bookkeeping@jaccountancy.co.uk
SMTP_FROM_NAME=Jaccountancy
SMTP_USE_TLS=true
ME_REPORT_BCC_EMAIL=fmfhdkgaptpyubgms@accountancymanager.co.uk
GMAIL_CLIENT_ID=replace-me
GMAIL_CLIENT_SECRET=replace-me
GMAIL_REDIRECT_URI=https://creditcontrolconsole-production.up.railway.app/auth/gmail/callback
GMAIL_SCOPES=openid email https://www.googleapis.com/auth/gmail.send
